##############################################################
# PEFDPP Ontology — PEF Geographies SKOS Concept Scheme
# https://w3id.org/mintjesba/pefdpp/skos/pef-geographies
##############################################################

@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix act:     <https://w3id.org/mintjesba/pefdpp/activity#> .
@prefix pefdpp:  <https://w3id.org/mintjesba/pefdpp/pefdpp#> .
@prefix geo:     <https://w3id.org/mintjesba/pefdpp/skos/pef-geographies#> .
@prefix eu:      <http://publications.europa.eu/resource/authority/country/> .

##############################################################
# Ontology declaration
##############################################################

<https://w3id.org/mintjesba/pefdpp/skos/pef-geographies>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/mintjesba/pefdpp/skos/pef-geographies/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "PEF Geographies"@en ;
    dcterms:description "SKOS concept scheme of geographic regions used in PEF life cycle inventory data. Countries are thin concepts delegating identity to the EU Publications Office authority list via skos:exactMatch. Ecoinvent supranational regions and electricity grids are defined here."@en ;
    dcterms:creator <https://orcid.org/YOUR-ORCID> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-05-12"^^xsd:date ;
    dcterms:source <https://eplca.jrc.ec.europa.eu/> ;
    dcterms:references <http://publications.europa.eu/resource/authority/country/> ;
    dcterms:references <https://geography.ecoinvent.org/> ;
    .

##############################################################
# Concept scheme
##############################################################

pefdpp:PEFGeographies
    a skos:ConceptScheme ;
    dcterms:title "PEF Geographies"@en ;
    skos:definition "Geographic regions used in PEF life cycle inventory data. Includes all ISO 3166-1 alpha-2 countries, plus ecoinvent supranational regions and electricity grids."@en ;
    skos:hasTopConcept geo:GLO ;
    .

##############################################################
# Supranational regions (ecoinvent conventions)
##############################################################

geo:GLO
    a skos:Concept ;
    skos:inScheme pefdpp:PEFGeographies ;
    skos:prefLabel "Global"@en ;
    skos:notation "GLO" ;
    skos:scopeNote "Global geography covering all regions. Corresponds to ecoinvent region code GLO."@en ;
    skos:topConceptOf pefdpp:PEFGeographies ;
    .

geo:RoW
    a skos:Concept ;
    skos:inScheme pefdpp:PEFGeographies ;
    skos:prefLabel "Rest of World"@en ;
    skos:notation "RoW" ;
    skos:scopeNote "All regions not explicitly modelled. Corresponds to ecoinvent region code RoW. Defined dynamically per activity as global minus all explicitly modelled geographies."@en ;
    skos:broader geo:GLO ;
    .

geo:RER
    a skos:Concept ;
    skos:inScheme pefdpp:PEFGeographies ;
    skos:prefLabel "Europe"@en ;
    skos:notation "RER" ;
    skos:scopeNote "European region. Corresponds to ecoinvent region code RER."@en ;
    skos:broader geo:GLO ;
    .

geo:WEU
    a skos:Concept ;
    skos:inScheme pefdpp:PEFGeographies ;
    skos:prefLabel "Western Europe"@en ;
    skos:notation "WEU" ;
    skos:scopeNote "Western European region. Corresponds to ecoinvent region code WEU."@en ;
    skos:broader geo:RER ;
    .

geo:EEU
    a skos:Concept ;
    skos:inScheme pefdpp:PEFGeographies ;
    skos:prefLabel "Eastern Europe"@en ;
    skos:notation "EEU" ;
    skos:scopeNote "Eastern European region. Corresponds to ecoinvent region code EEU."@en ;
    skos:broader geo:RER ;
    .

geo:EUR
    a skos:Concept ;
    skos:inScheme pefdpp:PEFGeographies ;
    skos:prefLabel "Europe (EU27+)"@en ;
    skos:notation "EUR" ;
    skos:scopeNote "European Union 27 member states."@en ;
    skos:broader geo:RER ;
    .

geo:NAM
    a skos:Concept ;
    skos:inScheme pefdpp:PEFGeographies ;
    skos:prefLabel "North America"@en ;
    skos:notation "NAM" ;
    skos:scopeNote "North American region. Corresponds to ecoinvent region code NAM."@en ;
    skos:broader geo:GLO ;
    .

geo:SAM
    a skos:Concept ;
    skos:inScheme pefdpp:PEFGeographies ;
    skos:prefLabel "South America"@en ;
    skos:notation "SAM" ;
    skos:scopeNote "South American and Caribbean region. Corresponds to ecoinvent region code SAM."@en ;
    skos:broader geo:GLO ;
    .

geo:RAF
    a skos:Concept ;
    skos:inScheme pefdpp:PEFGeographies ;
    skos:prefLabel "Africa"@en ;
    skos:notation "RAF" ;
    skos:scopeNote "African region. Corresponds to ecoinvent region code RAF."@en ;
    skos:broader geo:GLO ;
    .

geo:RNA
    a skos:Concept ;
