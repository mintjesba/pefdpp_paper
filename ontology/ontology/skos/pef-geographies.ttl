geo:OCE
    a skos:Concept ;
    skos:inScheme pefdpp:PEFGeographies ;
    skos:prefLabel "Oceania"@en ;
    skos:notation "OCE" ;
    skos:scopeNote "Oceanian region. Corresponds to ecoinvent region code OCE."@en ;
    skos:broader geo:GLO ;
    .

geo:BRICS
    a skos:Concept ;
    skos:inScheme pefdpp:PEFGeographies ;
    skos:prefLabel "BRICS"@en ;
    skos:notation "BRICS" ;
    skos:scopeNote "Brazil, Russia, India, China, South Africa."@en ;
    skos:broader geo:GLO ;
