geo:OECD
    a skos:Concept ;
    skos:inScheme pefdpp:PEFGeographies ;
    skos:prefLabel "OECD"@en ;
    skos:notation "OECD" ;
    skos:scopeNote "Organisation for Economic Co-operation and Development member countries."@en ;
