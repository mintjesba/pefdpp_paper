##############################################################
# Concept scheme
##############################################################
ait:PEFAdditionalInformationTopics
    a skos:ConceptScheme ;
    dcterms:title "PEF Additional Information Topics" ;
    skos:definition "Extensible list of topics for PEF Studies' Additional Information."@en ;
    .

