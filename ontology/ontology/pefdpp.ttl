@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix act:    <https://w3id.org/mintjesba/pefdpp/activity#> .
@prefix flow:   <https://w3id.org/mintjesba/pefdpp/flow#> .
@prefix dataset: <https://w3id.org/mintjesba/pefdpp/dataset#> .
@prefix lcia:   <https://w3id.org/mintjesba/pefdpp/lcia#> .
@prefix prs:     <https://w3id.org/mintjesba/pefdpp/product-system#> .
@prefix ps:     <https://w3id.org/mintjesba/pefdpp/pefstudy#> .
@prefix :       <https://w3id.org/mintjesba/pefdpp/> .

<https://w3id.org/mintjesba/pefdpp/>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/mintjesba/pefdpp/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "PEFDPP Ontology"@en ;
    dcterms:description "Ontology for Product Environmental Footprint input and output data in Digital Product Passports"@en ;
    dcterms:creator <https://orcid.org/YOUR-ORCID> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-05-11"^^xsd:date ;

    # --- Inputs side ---
    owl:imports <https://w3id.org/mintjesba/pefdpp/dataquality> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/ilcdname> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/flow> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/activity> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/dataset> ;

    # --- Outputs side ---
    owl:imports <https://w3id.org/mintjesba/pefdpp/lcia> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/product-system> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

##############################################################
# PEF-required flag
# Boolean attached to properties indicating whether these are
# required for PEF compliance. 
# Intended for future SHACL validation profile.
##############################################################
:PEFRequired
    a owl:AnnotationProperty ;
    rdfs:label "required for PEF compliance"@en ;
    skos:definition "Flags whether this property is mandatory for full PEF compliance. Informative only, not enforced in OWL. Intended for a future SHACL conformance profile."@en ;
    .

##############################################################
# Cross-module axioms
# Range and domain axioms that cannot be declared in individual
# modules due to circular dependencies are resolved here.
##############################################################

# --- flow → activity (circular: activity imports flow) ---

flow:recyclingActivity
    rdfs:range act:Activity .

flow:energyRecoveryActivity
    rdfs:range act:Activity .

flow:disposalActivity
    rdfs:range act:Activity .

flow:sourcedFrom rdfs:range dataset:LCIDataset .

# --- lcia → product-system (circular: pefstudy imports both) ---

lcia:forLifeCycleStage
    rdfs:range prs:LifeCycleStage .

lcia:forActivityLink
    rdfs:range prs:ActivityLink .
