@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix act:   <https://w3id.org/mintjesba/pefdpp/activity#> .
@prefix flow:  <https://w3id.org/mintjesba/pefdpp/flow#> .
@prefix : <https://w3id.org/mintjesba/pefdpp/> .

<https://w3id.org/mintjesba/pefdpp/> 
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/mintjesba/pefdpp/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "PEFDPP Ontology"@en ;
    dcterms:description "Ontology for Product Environmental Footprint input and output data in Digital Product Passports"@en ;
    dcterms:creator <https://orcid.org/YOUR-ORCID> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-05-11"^^xsd:date ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/dataset> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/activity> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/flow> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/dataquality> ;
    .

##############################################################
# Cross-module axioms
# Range axioms that cannot be declared in individual modules
# due to circular dependencies are resolved here.
##############################################################

flow:recyclingActivity
    rdfs:range act:Activity .

flow:energyRecoveryActivity
    rdfs:range act:Activity .

flow:disposalActivity
    rdfs:range act:Activity .