<https://w3id.org/mintjesba/pefdpp/ef31-lciamethods>
    a owl:Ontology ;
    dcterms:title "EF 3.1 Life Cycle Impact Assessment Ontology" ;
    dcterms:creator "Berend Mintjes - Leiden University" ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories> ,
