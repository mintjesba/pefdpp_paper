        .

#####################################################################
# METHODS
#####################################################################
:LCIAMethod a owl:Class .

:forImpactCategory a owl:ObjectProperty ;
    rdfs:label "for impact category"@en ;
    rdfs:domain :LCIAMethod ;
    rdfs:range skos:Concept .

:usesImpactIndicator a owl:ObjectProperty ;
    rdfs:label "uses impact indicator"@en ;
    rdfs:domain :LCIAMethod ;
    rdfs:range efii:ImpactIndicator .

