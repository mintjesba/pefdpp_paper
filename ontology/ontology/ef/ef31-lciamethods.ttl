#####################################################################
# Impact Categories — EF 3.1
# Assert lcia:ImpactCategory on the SKOS concepts and link each to
# its characterisation method and indicator unit.
#####################################################################

efic:Acidification
    a lcia:ImpactCategory ;
    lcia:calculatedByMethod :b5c611c6-def3-11e6-bf01-fe55135034f3 ;
    lcia:hasIndicatorUnit efu:molHplusEq .

