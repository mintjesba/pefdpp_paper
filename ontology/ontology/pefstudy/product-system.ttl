##############################################################
# PEFDPP Ontology — Product System Module
# https://w3id.org/mintjesba/pefdpp/product-system
# Covers: ProductSystem, ActivityLink, LifeCycleStage
##############################################################

@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix act:      <https://w3id.org/mintjesba/pefdpp/activity#> .
@prefix pef:       <https://w3id.org/mintjesba/pefdpp/pefstudy#> .
@prefix prs:       <https://w3id.org/mintjesba/pefdpp/product-system#> .
@prefix :         <https://w3id.org/mintjesba/pefdpp/> .

##############################################################
# Ontology declaration
##############################################################

<https://w3id.org/mintjesba/pefdpp/product-system>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/mintjesba/pefdpp/product-system/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "PEFDPP Product System Module"@en ;
    dcterms:description "Classes and properties for modelling the product system of a PEF study, including activity links, life cycle stages, and system diagrams."@en ;
    dcterms:creator <https://orcid.org/YOUR-ORCID> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-05-22"^^xsd:date ;
    dcterms:references <http://xmlns.com/foaf/0.1/> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/activity> ;
    .

##############################################################
# ProductSystem
##############################################################

prs:ProductSystem
    a owl:Class ;
    rdfs:label "Product System"@en ;
    skos:definition "The set of activities and flows modelled in a PEF study, linked together to represent the life cycle of a product."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

##############################################################
# ActivityLink
##############################################################

prs:ActivityLink
    a owl:Class ;
    rdfs:label "Activity Link"@en ;
    skos:definition "A link between a product system and an activity, specifying the activity's role in the system and the life cycle stage it belongs to."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

##############################################################
# LifeCycleStage — individuals
##############################################################

prs:LifeCycleStage
    a owl:Class ;
    rdfs:label "Life Cycle Stage"@en ;
    skos:definition "A stage of the product life cycle as defined in the PEF methodology."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

prs:RawMaterialAcquisition
    a prs:LifeCycleStage ;
    rdfs:label "Raw material acquisition"@en ;
    skos:definition "The life cycle stage covering the extraction of resources from nature and their pre-processing, up to the point of entry into the production facility."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

prs:Manufacturing
    a prs:LifeCycleStage ;
    rdfs:label "Manufacturing"@en ;
    skos:definition "The life cycle stage covering the transformation of raw and intermediate materials into the final product within the production facility."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

prs:Distribution
    a prs:LifeCycleStage ;
    rdfs:label "Distribution"@en ;
    skos:definition "The life cycle stage covering transport and storage of the product from the production facility to the end user."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

prs:Use
    a prs:LifeCycleStage ;
    rdfs:label "Use"@en ;
    skos:definition "The life cycle stage covering the use of the product by the end user over its service life."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

prs:EndOfLife
    a prs:LifeCycleStage ;
    rdfs:label "End of life"@en ;
    skos:definition "The life cycle stage covering the collection, sorting, recycling, energy recovery, and disposal of the product at end of its service life."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

##############################################################
# CustomLifeCycleStage
##############################################################

prs:CustomLifeCycleStage
    a owl:Class ;
    rdfs:subClassOf prs:LifeCycleStage ;
    rdfs:label "Custom Life Cycle Stage"@en ;
    skos:definition "A user-defined life cycle stage usable wherever a LifeCycleStage is expected. Each custom stage must correspond to exactly one of the five default PEF stages and carry a justification for the custom naming."@en ;
    skos:scopeNote "Custom stages must map to a default stage (no custom-to-custom chains)."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

##############################################################
# Object properties — ProductSystem
##############################################################

prs:hasActivityLink
    a owl:ObjectProperty ;
    rdfs:label "has activity link"@en ;
    skos:definition "An activity link connecting this product system to a modelled activity."@en ;
    rdfs:domain prs:ProductSystem ;
    rdfs:range prs:ActivityLink ;
    :PEFRequired true ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

prs:hasSystemDiagram
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has system diagram"@en ;
    skos:definition "An image representing the system diagram of this product system."@en ;
    rdfs:domain prs:ProductSystem ;
    rdfs:range foaf:Image ;
    :PEFRequired true ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

##############################################################
# Object properties — ActivityLink
##############################################################

prs:forActivity
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "for activity"@en ;
    skos:definition "The activity that this activity link references within the product system."@en ;
    rdfs:domain prs:ActivityLink ;
    rdfs:range act:Activity ;
    :PEFRequired true ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

prs:hasLifeCycleStage
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has life cycle stage"@en ;
    skos:definition "The life cycle stage to which this activity link belongs."@en ;
    rdfs:domain prs:ActivityLink ;
    rdfs:range prs:LifeCycleStage ;
    :PEFRequired true ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

##############################################################
# Object properties — CustomLifeCycleStage
##############################################################

prs:correspondsToDefaultStage
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "corresponds to default stage"@en ;
    skos:definition "The default PEF life cycle stage that this custom life cycle stage maps onto."@en ;
    rdfs:domain prs:CustomLifeCycleStage ;
    rdfs:range prs:LifeCycleStage ;
    skos:scopeNote "Restrict the object to the five default stage individuals via a SHACL sh:in constraint to prevent custom-to-custom chains."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

##############################################################
# Datatype properties — CustomLifeCycleStage
##############################################################

prs:namingJustification
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "naming justification"@en ;
    skos:definition "A justification for introducing this custom life cycle stage name rather than using the corresponding default PEF stage."@en ;
    rdfs:domain prs:CustomLifeCycleStage ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .
