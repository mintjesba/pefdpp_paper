##############################################################
# PEFDPP Ontology — PEF Study Module
# https://w3id.org/mintjesba/pefdpp/pefstudy
# Covers: PEFStudy, Goal, Scope, FunctionalUnit,
#         SystemBoundary, BoundaryType
##############################################################

@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix om:       <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix dq:       <https://w3id.org/mintjesba/pefdpp/dataquality#> .
@prefix flow:     <https://w3id.org/mintjesba/pefdpp/flow#> .
@prefix lcia:     <https://w3id.org/mintjesba/pefdpp/lcia#> .
@prefix ps:       <https://w3id.org/mintjesba/pefdpp/pefstudy#> .

##############################################################
# Ontology declaration
##############################################################

<https://w3id.org/mintjesba/pefdpp/pefstudy>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/mintjesba/pefdpp/pefstudy/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "PEFDPP PEF Study Module"@en ;
    dcterms:description "Classes and properties for the goal, scope, functional unit, and system boundary of a Product Environmental Footprint study."@en ;
    dcterms:creator <https://orcid.org/YOUR-ORCID> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-05-22"^^xsd:date ;
    dcterms:references <http://xmlns.com/foaf/0.1/> ;
    dcterms:references <http://www.ontology-of-units-of-measure.org/resource/om-2/> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/dataquality> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/flow> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/lcia> ;
    owl:imports <https://w3id.org/mintjesba/pefdpp/product-system> ;
    .

##############################################################
# PEFStudy
##############################################################

ps:PEFStudy
    a owl:Class ;
    rdfs:label "PEF Study"@en ;
    skos:definition "A Product Environmental Footprint study, comprising a goal, scope, product system, LCI data, and LCIA results."@en ;
    skos:scopeNote "Use dq:hasDataQuality to associate a DataQuality assessment with this study."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;

    # Required — exactly one
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:hasGoal ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:hasScope ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:hasProductSystem ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    # Optional
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty dq:hasDataQuality ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    .

##############################################################
# Goal
##############################################################

ps:Goal
    a owl:Class ;
    rdfs:label "Goal"@en ;
    skos:definition "The goal of a PEF study, describing its intended application, target audience, decision context, commissioner, and verifier."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;

    # Required — exactly one
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:intendedApplication ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:decisionContext ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    # Optional
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty dcterms:audience ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:commissioner ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:verifier ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    .

##############################################################
# Scope
##############################################################

ps:Scope
    a owl:Class ;
    rdfs:label "Scope"@en ;
    skos:definition "The scope of a PEF study, defining the functional unit, system boundary, impact categories, assumptions, and limitations."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;

    # Required — exactly one
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:hasFunctionalUnit ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:hasSystemBoundary ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:includesImpactCategory ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    # Optional
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:hasAssumption ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:hasLimitation ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:biodiversityRelevance ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    .

##############################################################
# FunctionalUnit
##############################################################

ps:FunctionalUnit
    a owl:Class ;
    rdfs:label "Functional Unit"@en ;
    skos:definition "The quantified description of the performance of a product system for use as a reference unit in a PEF study, answering what is provided, how well, how much, and for how long."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;

    # Required — exactly one
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:whatProvided ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:howWellProvided ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:howMuchProvided ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:howLongProvided ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:hasReferenceFlow ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    # Optional
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:notCoveredAspect ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty dcterms:conformsTo ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    .

##############################################################
# SystemBoundary
##############################################################

ps:SystemBoundary
    a owl:Class ;
    rdfs:label "System Boundary"@en ;
    skos:definition "The system boundary of a PEF study, specifying which life cycle stages and processes are included, the boundary type, cut-off criteria, and justification."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;

    # Required — exactly one
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:hasBoundaryType ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    # Optional
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:cutOffCriteria ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ps:systemBoundaryJustification ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    .

##############################################################
# BoundaryType — individuals
##############################################################

ps:BoundaryType
    a owl:Class ;
    rdfs:label "Boundary Type"@en ;
    skos:definition "The type of system boundary used in a PEF study."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:CradleToGrave
    a ps:BoundaryType ;
    rdfs:label "Cradle-to-grave"@en ;
    skos:definition "System boundary encompassing all life cycle stages from raw material acquisition through end-of-life."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:CradleToGate
    a ps:BoundaryType ;
    rdfs:label "Cradle-to-gate"@en ;
    skos:definition "System boundary encompassing raw material acquisition and manufacturing, up to the factory gate, excluding distribution, use, and end-of-life."@en ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

##############################################################
# Object properties — PEFStudy
##############################################################

ps:hasGoal
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has goal"@en ;
    skos:definition "The goal of this PEF study."@en ;
    rdfs:domain ps:PEFStudy ;
    rdfs:range ps:Goal ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:hasScope
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has scope"@en ;
    skos:definition "The scope of this PEF study."@en ;
    rdfs:domain ps:PEFStudy ;
    rdfs:range ps:Scope ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:hasProductSystem
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has product system"@en ;
    skos:definition "The product system modelled in this PEF study."@en ;
    rdfs:domain ps:PEFStudy ;
    rdfs:range ps:ProductSystem ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:hasLCIAResult
    a owl:ObjectProperty ;
    rdfs:label "has LCIA result"@en ;
    skos:definition "An LCIA result associated with this PEF study."@en ;
    rdfs:domain ps:PEFStudy ;
    rdfs:range lcia:LCIAResult ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:hasContributionResult
    a owl:ObjectProperty ;
    rdfs:label "has contribution result"@en ;
    skos:definition "A contribution result associated with this PEF study."@en ;
    rdfs:domain ps:PEFStudy ;
    rdfs:range lcia:ContributionResult ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

##############################################################
# Object properties — Goal
##############################################################

ps:commissioner
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "commissioner"@en ;
    skos:definition "The organisation or person who commissioned this PEF study."@en ;
    rdfs:domain ps:Goal ;
    rdfs:range foaf:Agent ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:verifier
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "verifier"@en ;
    skos:definition "The organisation or person who verified this PEF study."@en ;
    rdfs:domain ps:Goal ;
    rdfs:range foaf:Agent ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

##############################################################
# Object properties — Scope
##############################################################

ps:hasFunctionalUnit
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has functional unit"@en ;
    skos:definition "The functional unit of this PEF study scope."@en ;
    rdfs:domain ps:Scope ;
    rdfs:range ps:FunctionalUnit ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:hasSystemBoundary
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has system boundary"@en ;
    skos:definition "The system boundary of this PEF study scope."@en ;
    rdfs:domain ps:Scope ;
    rdfs:range ps:SystemBoundary ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:includesImpactCategory
    a owl:ObjectProperty ;
    rdfs:label "includes impact category"@en ;
    skos:definition "An impact category included in the scope of this PEF study."@en ;
    rdfs:domain ps:Scope ;
    rdfs:range lcia:ImpactCategory ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

##############################################################
# Object properties — FunctionalUnit
##############################################################

ps:hasReferenceFlow
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has reference flow"@en ;
    skos:definition "The reference flow quantifying the functional unit — the flow to which all other flows are scaled."@en ;
    rdfs:domain ps:FunctionalUnit ;
    rdfs:range flow:Flow ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:howMuchProvided
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "how much provided"@en ;
    skos:definition "The quantity of the function provided, expressed as an om:Measure."@en ;
    rdfs:domain ps:FunctionalUnit ;
    rdfs:range om:Measure ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:howLongProvided
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "how long provided"@en ;
    skos:definition "The duration over which the function is provided, expressed as an om:Measure."@en ;
    rdfs:domain ps:FunctionalUnit ;
    rdfs:range om:Measure ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:conformsToStandard
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "conforms to standard"@en ;
    skos:definition "A standard or methodology that this functional unit or study conforms to."@en ;
    rdfs:domain ps:FunctionalUnit ;
    rdfs:range dcterms:Standard ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

##############################################################
# Object properties — SystemBoundary
##############################################################

ps:hasBoundaryType
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has boundary type"@en ;
    skos:definition "The type of system boundary applied in this PEF study."@en ;
    rdfs:domain ps:SystemBoundary ;
    rdfs:range ps:BoundaryType ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

##############################################################
# Datatype properties — Goal
##############################################################

ps:intendedApplication
    a owl:DatatypeProperty ;
    rdfs:label "intended application"@en ;
    skos:definition "A description of the intended application of this PEF study."@en ;
    rdfs:domain ps:Goal ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:decisionContext
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "decision context"@en ;
    skos:definition "The decision context for which this PEF study is conducted — the type of decision it is intended to support."@en ;
    rdfs:domain ps:Goal ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

##############################################################
# Datatype properties — Scope
##############################################################

ps:hasAssumption
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has assumption"@en ;
    skos:definition "Key assumptions made in this PEF study scope."@en ;
    rdfs:domain ps:Scope ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:hasLimitation
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has limitation"@en ;
    skos:definition "Key limitations of this PEF study scope."@en ;
    rdfs:domain ps:Scope ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:biodiversityRelevance
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "biodiversity relevance"@en ;
    skos:definition "A statement on the relevance of biodiversity impacts to this PEF study."@en ;
    rdfs:domain ps:Scope ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

##############################################################
# Datatype properties — FunctionalUnit
##############################################################

ps:whatProvided
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "what provided"@en ;
    skos:definition "A description of what function or service the product system provides."@en ;
    rdfs:domain ps:FunctionalUnit ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:howWellProvided
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "how well provided"@en ;
    skos:definition "A description of the quality or performance level at which the function is provided."@en ;
    rdfs:domain ps:FunctionalUnit ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:notCoveredAspect
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "not covered aspect"@en ;
    skos:definition "An aspect of the function that is explicitly not covered by this functional unit."@en ;
    rdfs:domain ps:FunctionalUnit ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

##############################################################
# Datatype properties — SystemBoundary
##############################################################

ps:cutOffCriteria
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "cut-off criteria"@en ;
    skos:definition "The criteria applied to determine which processes or flows are excluded from the system boundary."@en ;
    rdfs:domain ps:SystemBoundary ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .

ps:systemBoundaryJustification
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "system boundary justification"@en ;
    skos:definition "A justification for the chosen system boundary."@en ;
    rdfs:domain ps:SystemBoundary ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/mintjesba/pefdpp/pefstudy> ;
    .
