:HousingCoolingManufacturingAct_flow2_BatteryJacketImpactExtru
    a flow:Flow ;
    flow:hasFlowType ft:ImpactExtrusionOfAluminium1Stroke ;
    flow:contextualLabel "Battery jacket: Impact Extrusion of Aluminium" ;
    act:inputOf :HousingCoolingManufacturingAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.7316365478804254"^^xsd:decimal ] .

:HousingCoolingManufacturingAct_flow3_BatteryJacketPlastic3
    a flow:Flow ;
    flow:hasFlowType ft:PolyethyleneHighDensityGranulate ;
    flow:contextualLabel "Battery jacket: Plastic (3%)" ;
    act:inputOf :HousingCoolingManufacturingAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.022627934470528622"^^xsd:decimal ] .

:HousingCoolingManufacturingAct_flow4_BatteryJacketPlasticInje
    a flow:Flow ;
    flow:hasFlowType ft:InjectionMoulding ;
    flow:contextualLabel "Battery jacket: Plastic Injection Moulding" ;
    act:inputOf :HousingCoolingManufacturingAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.022627934470528622"^^xsd:decimal ] .

:HousingCoolingManufacturingAct_flow5_CoolantEthyleneGlycol50
    a flow:Flow ;
    flow:hasFlowType ft:EthyleneGlycol ;
    flow:contextualLabel "Coolant: ethylene glycol (50%)" ;
    act:inputOf :HousingCoolingManufacturingAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.11631481168721498"^^xsd:decimal ] .

:HousingCoolingManufacturingAct_flow6_CoolantWater50
    a flow:Flow ;
    flow:hasFlowType ft:TapWater ;
    flow:contextualLabel "Coolant: water (50%)" ;
    act:inputOf :HousingCoolingManufacturingAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.11631481168721498"^^xsd:decimal ] .

:HousingCoolingManufacturingAct_flow7_ElectronicPartsBatteryPa
    a flow:Flow ;
    flow:hasFlowType ft:AluminiumWroughtAlloy ;
    flow:contextualLabel "Electronic parts: Battery pack heater" ;
    act:inputOf :HousingCoolingManufacturingAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.006552947137307886"^^xsd:decimal ] .

:HousingCoolingManufacturingAct_flow8_BatteryPackHeaterAlumini
    a flow:Flow ;
    flow:hasFlowType ft:SheetRollingAluminium ;
    flow:contextualLabel "Battery pack heater: Aluminium sheet rolling" ;
    act:inputOf :HousingCoolingManufacturingAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.006552947137307886"^^xsd:decimal ] .

######################################################################
# FlowTypes produced by this dataset (with sourcedFrom)
######################################################################
ft:BatteryModuleLiIon a flow:ProductFlow ;
    rdfs:label "battery module, Li-ion"@en ;
    flow:sourcedFrom <https://w3id.org/mintjesba/pefdpp/cases/battery-pack/battery-module#ModuleDataset> .
ft:HousingAndCoolingSystem a flow:ProductFlow ;
    rdfs:label "housing and cooling system"@en ;
    flow:sourcedFrom <https://w3id.org/mintjesba/pefdpp/cases/battery-pack/battery-module#ModuleDataset> .
