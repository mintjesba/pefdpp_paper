    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.711"^^xsd:decimal ] .

:BatteryCellTreatmentAct_flow11_DirectProcessCO2Emission
    a flow:Flow ;
    flow:hasFlowType ft:08a91e70-3ddc-11dd-923d-0050c2490048 ;
    flow:contextualLabel "direct process CO2 emissions (cumulative)" ;
    act:outputOf :BatteryCellTreatmentAct ;
