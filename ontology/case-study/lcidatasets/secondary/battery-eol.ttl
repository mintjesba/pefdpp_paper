    flow:contextualLabel "Pyrometallurgical treatment of battery cells" ;
    act:outputOf :BatteryCellTreatmentAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "1"^^xsd:decimal ] .

:BatteryCellTreatmentAct_flow1_ElectricityForPyrometall
    a flow:Flow ;
