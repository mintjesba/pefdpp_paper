:BatteryCellTreatmentAct_flow7_QuicklimeCAO
    a flow:Flow ;
    flow:hasFlowType ft:QuicklimeProductionTechnologyMix ;
    flow:contextualLabel "quicklime (CAO)" ;
    act:inputOf :BatteryCellTreatmentAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.08"^^xsd:decimal ] .

:BatteryCellTreatmentAct_flow8_CarbonBlack
    a flow:Flow ;
    flow:hasFlowType ft:CarbonBlack ;
    flow:contextualLabel "carbon black" ;
    act:inputOf :BatteryCellTreatmentAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.001"^^xsd:decimal ] .

:BatteryCellTreatmentAct_flow9_MetalsToHydrometallurgic
    a flow:Flow ;
