@prefix :        <https://w3id.org/mintjesba/pefdpp/cases/battery-pack/battery-eol#> .
@prefix ft:      <https://w3id.org/mintjesba/pefdpp/cases/battery-pack/flowtypes#> .
@prefix pefdpp:  <https://w3id.org/mintjesba/pefdpp/> .
@prefix dataset: <https://w3id.org/mintjesba/pefdpp/dataset#> .
@prefix act:     <https://w3id.org/mintjesba/pefdpp/activity#> .
@prefix flow:    <https://w3id.org/mintjesba/pefdpp/flow#> .
@prefix dq:      <https://w3id.org/mintjesba/pefdpp/dataquality#> .
@prefix efu:     <https://w3id.org/mintjesba/pefdpp/ef31-units#> .
@prefix geo:     <https://w3id.org/mintjesba/pefdpp/skos/pef-geographies#> .
@prefix om:      <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

######################################################################
# CASE STUDY - BatteryEoL
######################################################################

<https://w3id.org/mintjesba/pefdpp/cases/battery-pack/battery-eol>
    a owl:Ontology ;
    owl:imports pefdpp: ;
    dcterms:title "BatteryEoL — LCIDataset (case study)"@en ;
    dcterms:creator "Berend Mintjes - Leiden University" .

:BatteryEoL
    a dataset:LCIDataset ;
    dcterms:title "BatteryEoL"@en ;
    dataset:hasDatasetType dataset:Secondary ;
    dataset:hasComplianceLevel dataset:EFCompliant ;
    dq:hasDataQuality [ a dq:DataQuality ;
        dq:hasOverallDQR "3"^^xsd:decimal ;
        dq:hasDQRCriterion
        [ a dq:DQRCriterion ; dq:forDimension dq:TechnologicalRepresentativeness ; dq:hasValue 2 ; ] ,
        [ a dq:DQRCriterion ; dq:forDimension dq:TimeRepresentativeness ; dq:hasValue 4 ; dq:hasJustification "2023 data" ; ] ,
        [ a dq:DQRCriterion ; dq:forDimension dq:GeographicalRepresentativeness ; dq:hasValue 2 ; dq:hasJustification "dataset on RER" ; ]
    ] ;
    dataset:containsActivity
        :BatteryDisassemblyAct ,
        :BatteryCellTreatmentAct ,
        :MetalTreatmentAct .

######################################################################
# ActivityTypes used in this dataset
######################################################################
act:BatteryCellTreatment a act:ActivityType ; rdfs:label "BatteryCellTreatment"@en .
act:BattteryDisassembly a act:ActivityType ; rdfs:label "BattteryDisassembly"@en .
act:MetalTreatment a act:ActivityType ; rdfs:label "MetalTreatment"@en .

:BatteryDisassemblyAct
    a act:Activity ;
    act:hasActivityType act:BattteryDisassembly ;
    act:isCompanySpecific false ;
    act:hasGeography geo:RER ;
    act:hasDeterminingFlow :BatteryDisassemblyAct_flow0_EoLBatteryDisassemblyRef .

:BatteryDisassemblyAct_flow0_EoLBatteryDisassemblyRef
    a flow:Flow ;
    flow:hasFlowType ft:EoLBatteryDisassembly ;
    flow:contextualLabel "EoL battery disassembly reference flow" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "1"^^xsd:decimal ] .

:BatteryDisassemblyAct_flow1_PyrometallurgicalTreatme
    a flow:Flow ;
    flow:hasFlowType ft:PyrometallurgicalTreatmentOfBatteryCells ;
    flow:contextualLabel "Pyrometallurgical treatment, battery cells" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.72590929"^^xsd:decimal ] .

:BatteryDisassemblyAct_flow2_AluminiumWaste
    a flow:Flow ;
    flow:hasFlowType ft:AluminiumWaste ;
    flow:contextualLabel "aluminium waste" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.18028051"^^xsd:decimal ] ;
    flow:hasEndOfLifeScenario [ a flow:EndOfLifeScenario ;
        flow:recyclingRate [ a flow:CFFValue ; flow:hasValue "0.95"^^xsd:decimal ] ;
        flow:energyRecoveryRate [ a flow:CFFValue ; flow:hasValue "0"^^xsd:decimal ] ;
        flow:virginEquivalent ft:AluminiumWroughtAlloy ;
        flow:recyclingFlowType ft:AluminiumRecycling ;
        flow:disposalFlowType ft:LandfillInertWaste
        ] .

:BatteryDisassemblyAct_flow3_CopperWaste
    a flow:Flow ;
    flow:hasFlowType ft:CopperWaste ;
    flow:contextualLabel "copper waste" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.0031511300000000003"^^xsd:decimal ] ;
    flow:hasEndOfLifeScenario [ a flow:EndOfLifeScenario ;
        flow:recyclingRate [ a flow:CFFValue ; flow:hasValue "0.95"^^xsd:decimal ] ;
        flow:energyRecoveryRate [ a flow:CFFValue ; flow:hasValue "0"^^xsd:decimal ] ;
        flow:virginEquivalent ft:Copper ;
        flow:recyclingFlowType ft:CopperRecycling ;
        flow:disposalFlowType ft:LandfillInertWaste
        ] .

:BatteryDisassemblyAct_flow4_SteelWaste
    a flow:Flow ;
    flow:hasFlowType ft:SteelWaste ;
    flow:contextualLabel "steel waste" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.006181042105263158"^^xsd:decimal ] ;
    flow:hasEndOfLifeScenario [ a flow:EndOfLifeScenario ;
        flow:recyclingRate [ a flow:CFFValue ; flow:hasValue "0.95"^^xsd:decimal ] ;
        flow:energyRecoveryRate [ a flow:CFFValue ; flow:hasValue "0"^^xsd:decimal ] ;
        flow:virginEquivalent ft:Steel ;
        flow:recyclingFlowType ft:SteelRecycling ;
        flow:disposalFlowType ft:LandfillInertWaste
        ] .

:BatteryDisassemblyAct_flow5_PolymerWaste
    a flow:Flow ;
    flow:hasFlowType ft:PolymerWaste ;
    flow:contextualLabel "polymer waste" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.0061242"^^xsd:decimal ] ;
    flow:hasEndOfLifeScenario [ a flow:EndOfLifeScenario ;
        flow:recyclingRate [ a flow:CFFValue ; flow:hasValue "0.5"^^xsd:decimal ] ;
        flow:energyRecoveryRate [ a flow:CFFValue ; flow:hasValue "0"^^xsd:decimal ] ;
        flow:virginEquivalent ft:PolypropyleneGranulate ;
        flow:recyclingFlowType ft:PolymerRecycling ;
        flow:disposalFlowType ft:LandfillInertWaste
        ] .

:BatteryDisassemblyAct_flow6_ElectronicsSentToElectro
    a flow:Flow ;
    flow:hasFlowType ft:TreatmentOfElectronicsScrapMetalsRecoveryInCopperSmelter ;
    flow:contextualLabel "Electronics sent to electronics treatment" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.03532892"^^xsd:decimal ] .

:BatteryDisassemblyAct_flow7_OtherResidualsCoolantAnd
    a flow:Flow ;
    flow:hasFlowType ft:CoolantWaterGlycolResidualTreatment ;
    flow:contextualLabel "Other residuals: coolant and water-glycol fraction" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.04302493"^^xsd:decimal ] .

:BatteryCellTreatmentAct
    a act:Activity ;
    act:hasActivityType act:BatteryCellTreatment ;
    act:isCompanySpecific false ;
    act:hasGeography geo:RER ;
    act:hasDeterminingFlow :BatteryCellTreatmentAct_flow0_PyrometallurgicalTreatme .

