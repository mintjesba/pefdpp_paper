######################################################################
# FlowTypes produced by this dataset (with sourcedFrom)
######################################################################
ft:EoLBatteryDisassembly a flow:ProductFlow ;
    rdfs:label "EoL battery disassembly"@en ;
    flow:sourcedFrom <https://w3id.org/mintjesba/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
ft:PyrometallurgicalTreatmentOfBatteryCells a flow:WasteFlow ;
    rdfs:label "Pyrometallurgical treatment of battery cells"@en ;
    flow:sourcedFrom <https://w3id.org/mintjesba/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
ft:AluminiumWaste a flow:WasteFlow ;
    rdfs:label "aluminium waste"@en ;
    flow:sourcedFrom <https://w3id.org/mintjesba/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
ft:CopperWaste a flow:WasteFlow ;
    rdfs:label "copper waste"@en ;
    flow:sourcedFrom <https://w3id.org/mintjesba/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
ft:HydrometallurgicalTreatmentOfMetals a flow:WasteFlow ;
    rdfs:label "hydrometallurgical treatment of metals"@en ;
    flow:sourcedFrom <https://w3id.org/mintjesba/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
ft:PolymerWaste a flow:WasteFlow ;
    rdfs:label "polymer waste"@en ;
    flow:sourcedFrom <https://w3id.org/mintjesba/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
ft:SteelWaste a flow:WasteFlow ;
    rdfs:label "steel waste"@en ;
    flow:sourcedFrom <https://w3id.org/mintjesba/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
