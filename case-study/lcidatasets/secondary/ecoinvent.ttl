@prefix ft:      <https://w3id.org/pefdpp/cases/battery-pack/flowtypes#> .
@prefix act: <https://w3id.org/pefdpp/activity#> .
@prefix geo: <https://w3id.org/pefdpp/skos/pef-geographies#> .
@prefix pefdpp:  <https://w3id.org/pefdpp/> .
@prefix dataset: <https://w3id.org/pefdpp/dataset#> .
@prefix flow:    <https://w3id.org/pefdpp/flow#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <https://w3id.org/pefdpp/cases/battery-pack/ecoinvent#> .
@prefix dq:      <https://w3id.org/pefdpp/dataquality#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

######################################################################
# SECONDARY DATASET — ecoinvent (FlowTypes ONLY, each with sourcedFrom)
######################################################################

<https://w3id.org/pefdpp/cases/battery-pack/ecoinvent>
    a owl:Ontology ;
    owl:imports pefdpp: ;
    dcterms:title "ecoinvent — FlowTypes (secondary data)"@en .

@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix void:    <http://rdfs.org/ns/void#> .

:ecoinvent
    a dataset:LCIDataset ;
    dcterms:title "ecoinvent 3.12 — Allocation, cut-off by classification"@en ;
    dcterms:description "Life cycle inventory (LCI) background database providing unit process and system process data for more than 26,000 peer-reviewed datasets. Uses the cut-off system model, in which recyclable materials are free at the point of recycling and the producer bears no credit or burden for end-of-life. Default system model for PEF compliance studies and EN 15804+A2 EPDs."@en ;
    dcterms:version "3.12" ;
    dcterms:issued "2025-11"^^xsd:gYearMonth ;
    dcterms:publisher [
        a foaf:Organization ;
        foaf:name "ecoinvent Association" ;
        foaf:homepage <https://ecoinvent.org/>
    ] ;
    dcterms:creator [
        a foaf:Organization ;
        foaf:name "ecoinvent Association" ;
        foaf:homepage <https://ecoinvent.org/>
    ] ;
    dcterms:license <https://ecoinvent.org/terms-of-use/> ;
    dcterms:rights "Commercial licence required. Academic and commercial licences available from ecoinvent Association."@en ;
    dcterms:format "application/xml" ;
    dcterms:conformsTo <https://www.ecoinvent.org/files/201808_ecoSpold02_format_description_v1_pdf.pdf> ;
    dcterms:isPartOf <https://ecoinvent.org/ecoinvent-v3-12/> ;
    dcterms:isVersionOf <https://ecoinvent.org/database/> ;
    dcterms:keyword "life cycle inventory"@en, "LCA"@en, "background database"@en,
                    "cut-off"@en, "attributional"@en, "EF 3.1"@en, "PEF"@en ;
    dcat:landingPage <https://ecoinvent.org/ecoinvent-v3-12/> ;
    dcat:accessURL <https://ecoquery.ecoinvent.org/> ;
    void:vocabulary <http://www.ecoinvent.org/EcoSpold02> ;

    dataset:hasComplianceLevel dataset:NotEFCompliant ;
    dq:hasDataQuality [ a dq:DataQuality ;
        dq:hasOverallDQR "3.66667"^^xsd:decimal ;
        dq:hasDQRCriterion
        [ a dq:DQRCriterion ; dq:forDimension dq:TechnologicalRepresentativeness ; dq:hasValue 3 ; dq:hasJustification "partly included" ; ] ,
        [ a dq:DQRCriterion ; dq:forDimension dq:TimeRepresentativeness ; dq:hasValue 5 ; dq:hasJustification "different validities for different flows" ; ] ,
        [ a dq:DQRCriterion ; dq:forDimension dq:GeographicalRepresentativeness ; dq:hasValue 3 ; dq:hasJustification "global dataset" ; ]
    ] .

