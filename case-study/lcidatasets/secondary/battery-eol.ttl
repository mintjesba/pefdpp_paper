    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.00974"^^xsd:decimal ] .

:MetalTreatmentAct_flow6_HydrogenPeroxide100
    a flow:Flow ;
    flow:hasFlowType ft:HydrogenPeroxide ;
    flow:contextualLabel "Hydrogen peroxide (100%)" ;
    act:inputOf :MetalTreatmentAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.30027"^^xsd:decimal ] .

:MetalTreatmentAct_flow7_SodaSodiumCarbonate
    a flow:Flow ;
    flow:hasFlowType ft:Soda ;
    flow:contextualLabel "Soda (sodium carbonate)" ;
    act:inputOf :MetalTreatmentAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.01623"^^xsd:decimal ] .

:MetalTreatmentAct_flow8_SodiumHydroxide100Causti
    a flow:Flow ;
    flow:hasFlowType ft:SodiumHydroxide ;
    flow:contextualLabel "Sodium hydroxide (100%; caustic soda)" ;
    act:inputOf :MetalTreatmentAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.45446"^^xsd:decimal ] .

:MetalTreatmentAct_flow9_SulphuricAcidAq96
    a flow:Flow ;
    flow:hasFlowType ft:SulfuricAcid ;
    flow:contextualLabel "Sulphuric acid aq. (96%)" ;
    act:inputOf :MetalTreatmentAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.87646"^^xsd:decimal ] .

:MetalTreatmentAct_flow10_WaterTapWater
    a flow:Flow ;
    flow:hasFlowType ft:TapWater ;
    flow:contextualLabel "Water (tap water)" ;
    act:inputOf :MetalTreatmentAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.00278"^^xsd:decimal ] .

:MetalTreatmentAct_flow11_Wastewater
    a flow:Flow ;
    flow:hasFlowType ft:Wastewater ;
    flow:contextualLabel "wastewater" ;
    act:outputOf :MetalTreatmentAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.00278"^^xsd:decimal ] .

:MetalTreatmentAct_flow12_AluminiumWaste
    a flow:Flow ;
    flow:hasFlowType ft:AluminiumWaste ;
    flow:contextualLabel "aluminium recovered from metal alloy" ;
    act:outputOf :MetalTreatmentAct ;
    # Cell-level aluminium (current collector, cell container) not captured by
    # BatteryDisassemblyAct_flow2_AluminiumWaste (housing/module-level only,
    # per Table 7 vs. Table 9 of the source recycling model). Amount derived
    # from the true manufacturing-stage aluminium mass (0.223326638 kg per kg
    # battery, computed via each activity's actual activation scale) minus
    # what's already tracked at disassembly (0.18028051 kg), then converted
    # onto MetalTreatmentAct's own scale. MetalTreatmentAct's activation is
    # 0.72590929 per kg battery -- NOT its production-exchange amount
    # (0.577) times BatteryCellTreatmentAct's activation (0.725909): since
    # MetalTreatmentAct's own production amount is also 0.577, that factor
    # cancels in brightway's solve, leaving its activation equal to
    # BatteryCellTreatmentAct's (confirmed against the actual solved supply
    # array). (0.223326638 - 0.18028051) / 0.72590929. Shares
    # AluminiumCFFScenario with the housing-level aluminium -- same material
    # family, same recycling/allocation parameters.
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.05929959698645503"^^xsd:decimal ] ;
    flow:hasCFFScenario :AluminiumCFFScenario .

:MetalTreatmentAct_flow13_CopperWaste
    a flow:Flow ;
    flow:hasFlowType ft:CopperWaste ;
    flow:contextualLabel "copper recovered from metal alloy" ;
    act:outputOf :MetalTreatmentAct ;
    # Cell-level copper (current collector foil, cell container negative
    # terminal) not captured by BatteryDisassemblyAct_flow3_CopperWaste
    # (pack/module terminals only). Amount derived the same way as the
    # aluminium flow above: (0.117318673 - 0.00315113) / 0.72590929.
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.15727521971860597"^^xsd:decimal ] ;
    flow:hasCFFScenario :CopperCFFScenario .

######################################################################
# FlowTypes produced by this dataset (with sourcedFrom)
######################################################################
ft:EoLBatteryDisassembly a flow:WasteFlow ;
    rdfs:label "EoL battery disassembly"@en ;
    flow:sourcedFrom <https://w3id.org/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
ft:BatteryCellToTreatment a flow:WasteFlow ;
    rdfs:label "battery cells, to pyrometallurgical treatment"@en ;
    flow:sourcedFrom <https://w3id.org/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
ft:AluminiumWaste a flow:WasteFlow ;
    rdfs:label "aluminium waste"@en ;
    flow:sourcedFrom <https://w3id.org/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
ft:CopperWaste a flow:WasteFlow ;
    rdfs:label "copper waste"@en ;
    flow:sourcedFrom <https://w3id.org/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
ft:MetalAlloyToTreatment a flow:WasteFlow ;
    rdfs:label "metal alloy, to hydrometallurgical treatment"@en ;
    flow:sourcedFrom <https://w3id.org/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
ft:HydrometallurgicalTreatmentOfMetals a flow:WasteFlow ;
    rdfs:label "hydrometallurgical treatment of metals"@en ;
    flow:sourcedFrom <https://w3id.org/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
ft:PolymerWaste a flow:WasteFlow ;
    rdfs:label "polymer waste"@en ;
    flow:sourcedFrom <https://w3id.org/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
ft:SteelWaste a flow:WasteFlow ;
    rdfs:label "steel waste"@en ;
    flow:sourcedFrom <https://w3id.org/pefdpp/cases/battery-pack/battery-eol#BatteryEoL> .
