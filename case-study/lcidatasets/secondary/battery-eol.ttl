@prefix :        <https://w3id.org/pefdpp/cases/battery-pack/battery-eol#> .
@prefix ft:      <https://w3id.org/pefdpp/cases/battery-pack/flowtypes#> .
@prefix ecoinvent: <https://w3id.org/pefdpp/cases/battery-pack/ecoinvent#> .
@prefix pefdpp:  <https://w3id.org/pefdpp/> .
@prefix dataset: <https://w3id.org/pefdpp/dataset#> .
@prefix act:     <https://w3id.org/pefdpp/activity#> .
@prefix flow:    <https://w3id.org/pefdpp/flow#> .
@prefix dq:      <https://w3id.org/pefdpp/dataquality#> .
@prefix efu:     <https://w3id.org/pefdpp/ef31-units#> .
@prefix geo:     <https://w3id.org/pefdpp/skos/pef-geographies#> .
@prefix om:      <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


######################################################################
# CASE STUDY - BatteryEoL
######################################################################

<https://w3id.org/pefdpp/cases/battery-pack/battery-eol>
    a owl:Ontology ;
    owl:imports pefdpp: ;
    dcterms:title "BatteryEoL — LCIDataset (case study)"@en ;
    dcterms:creator "Berend Mintjes - Leiden University" .

:BatteryEoL
    a dataset:LCIDataset ;
    dcterms:title "BatteryEoL"@en ;
    dataset:hasDatasetType dataset:Secondary ;
    dataset:hasComplianceLevel dataset:EFCompliant ;
    dq:hasDataQuality [ a dq:DataQuality ;
        dq:hasOverallDQR "3"^^xsd:decimal ;
        dq:hasDQRCriterion
        [ a dq:DQRCriterion ; dq:forDimension dq:TechnologicalRepresentativeness ; dq:hasValue 2 ; ] ,
        [ a dq:DQRCriterion ; dq:forDimension dq:TimeRepresentativeness ; dq:hasValue 4 ; dq:hasJustification "2023 data" ; ] ,
        [ a dq:DQRCriterion ; dq:forDimension dq:GeographicalRepresentativeness ; dq:hasValue 2 ; dq:hasJustification "dataset on RER" ; ]
    ] ;
    dataset:containsActivity
        :BatteryDisassemblyAct ,
        :BatteryCellTreatmentAct ,
        :MetalTreatmentAct .

######################################################################
# ActivityTypes used in this dataset
######################################################################
act:BatteryCellTreatment a act:ActivityType ; rdfs:label "Battery Cell Treatment"@en .
act:BatteryDisassembly a act:ActivityType ; rdfs:label "Battery Disassembly"@en .
act:MetalTreatment a act:ActivityType ; rdfs:label "Metal Treatment"@en .

:BatteryDisassemblyAct
    a act:Activity ;
    act:hasActivityType act:BatteryDisassembly ;
    act:isCompanySpecific false ;
    act:hasGeography geo:RER ;
    act:hasDeterminingFlow :BatteryDisassemblyAct_flow0_EoLBatteryDisassemblyRef .

:BatteryDisassemblyAct_flow0_EoLBatteryDisassemblyRef
    a flow:Flow ;
    flow:hasFlowType ft:EoLBatteryDisassembly ;
    flow:contextualLabel "EoL treatment of kg battery pack"@en ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "1"^^xsd:decimal ] .

:BatteryDisassemblyAct_flow1_BatteryCellToTreatment
    a flow:Flow ;
    flow:hasFlowType ft:BatteryCellToTreatment ;
    flow:contextualLabel "pyrometallurgical treatment of battery cells"@en ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.72590929"^^xsd:decimal ] .

:BatteryDisassemblyAct_flow2_AluminiumWaste
    a flow:Flow ;
    flow:hasFlowType ft:AluminiumWaste ;
    flow:contextualLabel "aluminium waste" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.18028051"^^xsd:decimal ] ;
    flow:hasCFFScenario :AluminiumCFFScenario .

:AluminiumCFFScenario 
    a flow:CFFScenario ;
    flow:allocationFactorA [ a flow:CFFValue; flow:hasValue "0.2"^^xsd:decimal ] ;
    flow:recyclingRateR2 [ a flow:CFFValue ; flow:hasValue "0.90"^^xsd:decimal ] ;
    flow:qualityRatioIn [ a flow:CFFValue ; flow:hasValue "1"^^xsd:decimal ] ;
    flow:qualityRatioOut [ a flow:CFFValue ; flow:hasValue "1"^^xsd:decimal ] ;
    flow:virginMaterialActivity ecoinvent:AluminiumProduction ;
    flow:substitutedVirginActivity ecoinvent:AluminiumProduction ;
    flow:recyclingActivity ecoinvent:AluminiumRecycling ;
    flow:disposalActivity ecoinvent:AluminiumLandfill .

:BatteryDisassemblyAct_flow3_CopperWaste
    a flow:Flow ;
    flow:hasFlowType ft:CopperWaste ;
    flow:contextualLabel "copper waste" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.0031511300000000003"^^xsd:decimal ] ;
    flow:hasCFFScenario :CopperCFFScenario .

:CopperCFFScenario
    a flow:CFFScenario ;
    flow:allocationFactorA [ a flow:CFFValue ; flow:hasValue "0.2"^^xsd:decimal ] ;
    flow:recycledContentRateR1 [ a flow:CFFValue ; flow:hasValue "0.72"^^xsd:decimal ] ;
    flow:recyclingRateR2 [ a flow:CFFValue ; flow:hasValue "0.95"^^xsd:decimal ] ;
    flow:qualityRatioIn [ a flow:CFFValue ; flow:hasValue "1"^^xsd:decimal ] ;
    flow:qualityRatioOut [ a flow:CFFValue ; flow:hasValue "1"^^xsd:decimal ] ;
    flow:virginMaterialActivity ecoinvent:CopperProduction ;
    flow:substitutedVirginActivity ecoinvent:CopperProduction ;
    flow:recycledMaterialActivity ecoinvent:CopperRecycling ;
    flow:recyclingActivity ecoinvent:CopperRecycling ;
    flow:disposalActivity ecoinvent:InertMaterialLandfill .

:BatteryDisassemblyAct_flow4_SteelWaste
    a flow:Flow ;
    flow:hasFlowType ft:SteelWaste ;
    flow:contextualLabel "steel waste" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.006181042105263158"^^xsd:decimal ] ;
    flow:hasCFFScenario :SteelCFFScenario .

:SteelCFFScenario
    a flow:CFFScenario ;
    flow:allocationFactorA [ a flow:CFFValue ; flow:hasValue "0.2"^^xsd:decimal ] ;
    flow:recycledContentRateR1 [ a flow:CFFValue ; flow:hasValue "0.18"^^xsd:decimal ] ;
    flow:recyclingRateR2 [ a flow:CFFValue ; flow:hasValue "0.90"^^xsd:decimal ] ;
    flow:qualityRatioIn [ a flow:CFFValue ; flow:hasValue "1"^^xsd:decimal ] ;
    flow:qualityRatioOut [ a flow:CFFValue ; flow:hasValue "1"^^xsd:decimal ] ;
    flow:virginMaterialActivity ecoinvent:SteelProduction ;
    flow:substitutedVirginActivity ecoinvent:SteelProduction ;
    flow:recycledMaterialActivity ecoinvent:SteelRecycling ;
    flow:recyclingActivity ecoinvent:SteelRecycling ;
    flow:disposalActivity ecoinvent:InertMaterialLandfill .

:BatteryDisassemblyAct_flow5_PolymerWaste
    a flow:Flow ;
    flow:hasFlowType ft:WastePlasticMixture ;
    flow:contextualLabel "polymer waste" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.0061242"^^xsd:decimal ] ;
    .

:BatteryDisassemblyAct_flow6_ElectronicsSentToElectro
    a flow:Flow ;
    flow:hasFlowType ft:ElectronicsScrap ;
    flow:contextualLabel "Electronics sent to electronics treatment" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.03532892"^^xsd:decimal ] .

:BatteryDisassemblyAct_flow7_OtherResiduals
    a flow:Flow ;
    flow:hasFlowType ft:InertWaste ;
    flow:contextualLabel "Other residuals" ;
    act:outputOf :BatteryDisassemblyAct ;
    flow:hasMeasure [ a om:Measure ; om:hasUnit efu:Kilogram ; om:hasNumericalValue "0.04302493"^^xsd:decimal ] ;
    .

# BATTERY CELL TREATMENT
